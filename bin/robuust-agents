#!/usr/bin/env php
<?php

use Robuust\Boost\Console\Application;

$autoloaders = [
    $GLOBALS['_composer_autoload_path'] ?? null,
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_string($autoloader) && is_file($autoloader)) {
        require $autoloader;

        break;
    }
}

if (!class_exists(Application::class)) {
    fwrite(STDERR, "robuust-agents: run `composer install` first.\n");

    exit(1);
}

$arguments = array_values(array_filter(array_slice($_SERVER['argv'] ?? [], 1), 'is_string'));

exit((new Application(dirname(__DIR__)))->run($arguments));
